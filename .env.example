# Supabase設定
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API設定（ブログ自動生成機能）
VITE_OPENAI_API_KEY=your_openai_api_key_here

# SMTP設定（お問い合わせフォームメール送信）
# ※ Netlify環境変数にも同じ値を設定してください
# ※ パスワードは絶対に公開リポジトリにコミットしないでください

# Yahoo!メール（メイン送信元）
YAHOO_SMTP_HOST=smtp.mail.yahoo.co.jp
YAHOO_SMTP_PORT=465
YAHOO_SMTP_USER=rikasogabe@yahoo.co.jp
YAHOO_SMTP_PASS=your_yahoo_app_password_here

# Xサーバーメール（サブ送信元）
XSERVER_SMTP_HOST=sv14645.xserver.jp
XSERVER_SMTP_PORT=465
XSERVER_SMTP_USER=info@okinawa-yonabal.com
